# Copy this file to .env and fill in your real key. .env is gitignored —
# never commit real secrets.
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small

# Required — the API layer (api/app.py) refuses every request without a
# matching X-API-Key header (except /health). This is the built-in ADMIN
# key: full access, can ingest, queries every category. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional — path to a JSON file defining ADDITIONAL, more restricted API
# keys (role-scoped: which categories they can query, whether they can
# ingest at all). See access_control.py and docs/design-decisions.md for
# the file format. Leave unset to have only the one admin key above.
ACCESS_CONTROL_CONFIG_PATH=

# Optional — get a free key at smith.langchain.com. Tracing turns on
# automatically the moment LANGSMITH_API_KEY is set; leave unset to skip it.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-agentic-rag

# Optional — Google Drive connector. See docs/design-decisions.md for the
# service-account setup steps. Leave both unset to skip the connector.
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials/google_drive_service_account.json
GOOGLE_DRIVE_FOLDER_ID=

# Optional — controls the API server's structured (JSON) log verbosity.
# Defaults to INFO. Does not affect main.py's CLI output.
LOG_LEVEL=INFO

# Optional — Cohere Rerank, reranks retrieval candidates for precision
# (see retrieval/reranker.py). Free trial key at dashboard.cohere.com.
# Leave unset to skip reranking (retrieval falls back to plain RRF order).
COHERE_API_KEY=
